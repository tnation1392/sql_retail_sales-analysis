-- We will start with a simple exploration of sales that occurred on 11/5/2025
SELECT *
FROM retail_sales
WHERE sale_date = '2022-11-07';

 -- Next we will widen that scope to the week of 11/7 - 11/13
SELECT *
FROM retail_sales
WHERE sale_date BETWEEN '2022-11-07' and '2022-11-13'
ORDER BY sale_date asc;

-- Then focus that search to one category
SELECT *
FROM retail_sales
WHERE sale_date BETWEEN '2022-11-07' and '2022-11-13'
AND category = 'Electronics'
ORDER BY sale_date asc;

-- Next we retrieve all clothing category sales where the quantity is more than 4 in the month of November 2022
SELECT *
FROM retail_sales
WHERE category = 'Clothing'
AND sale_date >= '2022-11-01' AND sale_date <='2022-11-30'
AND
quantity >=4
ORDER BY sale_date asc;

-- Next calculate the total sales for each category for the year
SELECT category, SUM(total_sale) as net_sale, COUNT(*) as total_orders
FROM retail_sales
GROUP BY 1

-- Find find the average age of customers who purchased items from the 'Beauty' category.
SELECT ROUND(AVG(age), 2) as avg_age
FROM retail_sales
WHERE category = 'Beauty';
